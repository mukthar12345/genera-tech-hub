{
  "version": 2,
  "public": false,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/src/pages/index.html" },
    { "source": "/index", "destination": "/src/pages/index.html" },
    { "source": "/products", "destination": "/src/pages/products.html" },
    { "source": "/product", "destination": "/src/pages/products.html" },
    { "source": "/product-detail", "destination": "/src/pages/product-detail.html" },
    { "source": "/repair", "destination": "/src/pages/repair.html" },
    { "source": "/swap", "destination": "/src/pages/swap.html" },
    { "source": "/contact", "destination": "/src/pages/contact.html" },
    { "source": "/about", "destination": "/src/pages/about.html" },
    { "source": "/reviews", "destination": "/src/pages/reviews.html" },
    { "source": "/login", "destination": "/src/pages/login.html" },
    { "source": "/signup", "destination": "/src/pages/login.html" },
    { "source": "/privacy", "destination": "/src/pages/privacy.html" },
    { "source": "/terms", "destination": "/src/pages/terms.html" },
    { "source": "/faq", "destination": "/src/pages/faq.html" },
    { "source": "/admin", "destination": "/src/pages/admin.html" },
    { "source": "/src", "destination": "/src/pages/index.html" },
    { "source": "/src/pages", "destination": "/src/pages/index.html" }
  ],
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}